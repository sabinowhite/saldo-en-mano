{
  "expo": {
    "name": "Saldo en Mano",
    "slug": "saldo-en-mano",
    "version": "0.3.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sabinowhite.saldoenmano",
      "buildNumber": "3",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.sabinowhite.saldoenmano",
      "versionCode": 3,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/saldo-icon.png",
        "backgroundColor": "#174E40"
      }
    },
    "web": {
      "name": "Saldo en Mano",
      "shortName": "Saldo en Mano"
    },
    "extra": {
      "developmentPreview": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usa Face ID para proteger el acceso a tus finanzas."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#176B57"
        }
      ],
      "expo-background-task"
    ],
    "scheme": "saldoenmano",
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/saldo-icon.png"
  }
}
