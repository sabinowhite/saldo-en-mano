{
  "expo": {
    "name": "Saldo en Mano",
    "slug": "saldo-en-mano",
    "version": "0.2.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sabinowhite.saldoenmano",
      "buildNumber": "2",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.sabinowhite.saldoenmano",
      "versionCode": 2,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "name": "Saldo en Mano",
      "shortName": "Saldo en Mano"
    },
    "extra": {
      "developmentPreview": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ]
    ],
    "scheme": "saldoenmano",
    "experiments": {
      "typedRoutes": true
    }
  }
}
